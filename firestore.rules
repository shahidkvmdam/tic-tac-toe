rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read/write access to users collection for authenticated users
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    // Allow read/write access to invitations collection for authenticated users
    match /invitations/{invitationId} {
      allow read, write: if request.auth != null;
    }

    // Allow read/write access to game requests collection for authenticated users
    match /gameRequests/{requestId} {
      allow read, write: if request.auth != null;
    }

    // Allow read/write access to messages collection for authenticated users
    match /messages/{messageId} {
      allow read, write: if request.auth != null;
    }

    // Allow read/write access to games collection for authenticated users
    match /games/{gameId} {
      allow read, write: if request.auth != null;
    }

    // Allow read/write access to matchmaking collection for authenticated users
    match /matchmaking/{matchId} {
      allow read, write: if request.auth != null;
    }
  }
}
